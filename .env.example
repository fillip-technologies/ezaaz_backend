NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ezaaz

# Auth: use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Frontend URL (CORS + links in emails)
CLIENT_URL=http://localhost:5173
RESET_TOKEN_TTL_MINUTES=15

# SMTP: leave SMTP_HOST empty in development to print emails to the console
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ejaz Hospital <no-reply@example.com>"

# Gets an email for every new appointment request (leave empty to skip)
APPOINTMENT_NOTIFY_EMAIL=

# WhatsApp booking messages via Meta's WhatsApp Cloud API. Full setup steps: WHATSAPP_SETUP.md
# Leave the token or phone number ID empty to print WhatsApp messages to the console instead.
# Permanent System User token with whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=
# WhatsApp Manager / developer app > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v26.0
# Must match the templates' language (npm run whatsapp:templates creates them in this language)
WHATSAPP_TEMPLATE_LANG=en
# Added in front of 10-digit numbers
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Hospital staff who get a WhatsApp for every new booking, comma-separated (leave empty to skip)
WHATSAPP_NOTIFY_NUMBERS=

# Managed Redis, e.g. rediss://default:<password>@<host>:<port>
# Public doctor data is read from Redis first, then MongoDB. Leave empty to skip caching.
REDIS_URL=
CACHE_TTL_SECONDS=3600
REDIS_KEY_PREFIX=ezaaz:

# Doctor photos are saved here (use a persistent disk in production)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=3

# Used by `npm run seed:admin` to create the admin account (only if none exists)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@123
