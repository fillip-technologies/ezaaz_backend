NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ezaaz

# Auth: use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Frontend URL (CORS + links in emails)
CLIENT_URL=http://localhost:5173
RESET_TOKEN_TTL_MINUTES=15

# SMTP: leave SMTP_HOST empty in development to print emails to the console
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ejaz Hospital <no-reply@example.com>"

# Gets an email for every new appointment request (leave empty to skip)
APPOINTMENT_NOTIFY_EMAIL=

# Managed Redis, e.g. rediss://default:<password>@<host>:<port>
# Public doctor data is read from Redis first, then MongoDB. Leave empty to skip caching.
REDIS_URL=
CACHE_TTL_SECONDS=3600
REDIS_KEY_PREFIX=ezaaz:

# Doctor photos are saved here (use a persistent disk in production)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=3

# Used by `npm run seed:admin` to create the admin account (only if none exists)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@123
